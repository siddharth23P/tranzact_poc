# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pdf_service
POSTGRES_USER=pdf
POSTGRES_PASSWORD=pdf

# Runtime application role (created by migrations). SELECT/INSERT/UPDATE on
# jobs, SELECT-only on manifest_entries. The API/worker serve traffic as this
# role — the owner/migrator role above is used ONLY by the boot migration runner.
APP_DB_USER=pdf_app
APP_DB_PASSWORD=pdf_app_pw

# Restricted, append-only manifest writer role (created by migrations).
# Has INSERT + SELECT on manifest_entries only; NO update/delete grants.
MANIFEST_DB_USER=manifest_writer
MANIFEST_DB_PASSWORD=manifest_writer_pw

# ---- Redis / BullMQ ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- S3 / MinIO ----
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=pdf-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---- Mock ERP ----
MOCK_ERP_URL=http://mock-erp:4000

# ---- API ----
API_PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# ---- Render worker ----
# Chromium binary (the Docker image installs the distro chromium here).
CHROMIUM_PATH=/usr/bin/chromium
# Warm Chromium page pool (N) and pages reserved for the single/fast lane (k).
# Bulk worker concurrency is capped at N-k so >=k pages stay free for singles.
RENDER_POOL_SIZE=4
RENDER_SINGLE_RESERVED=1
# Presigned artifact URL TTL (seconds).
PRESIGN_EXPIRY_SECONDS=3600
# ChunkedMerge: use it when a document's line-item count exceeds CHUNK_THRESHOLD,
# rendering CHUNK_SIZE rows per chunk. Tune from stress data.
CHUNK_THRESHOLD=50
CHUNK_SIZE=40
