# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pdf_service
POSTGRES_USER=pdf
POSTGRES_PASSWORD=pdf

# Restricted, append-only manifest writer role (created by migrations).
# Has INSERT + SELECT on manifest_entries only; NO update/delete grants.
MANIFEST_DB_USER=manifest_writer
MANIFEST_DB_PASSWORD=manifest_writer_pw

# ---- Redis / BullMQ ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- S3 / MinIO ----
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=pdf-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---- Mock ERP ----
MOCK_ERP_URL=http://mock-erp:4000

# ---- API ----
API_PORT=3000
LOG_LEVEL=info
NODE_ENV=development
